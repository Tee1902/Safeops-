NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=safeops_user
DB_PASSWORD=replace-with-a-local-database-password
DB_DATABASE=safeops_db
DB_SYNCHRONIZE=false
DB_LOGGING=false
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=safeops
JWT_AUDIENCE=safeops-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3001
TRUST_PROXY_HOPS=0
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_MAX_FILES=10
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@example.com
MAIL_USER=
MAIL_PASSWORD=
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_WS_URL=http://localhost:3000
SWAGGER_ENABLED=true
# Chỉ dùng khi chủ động chạy seed:admin; không có mật khẩu Admin mặc định.
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=SafeOps Administrator
ADMIN_PASSWORD=
# Dùng cho Docker Compose dev.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-local-pgadmin
