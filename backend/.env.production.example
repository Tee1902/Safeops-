NODE_ENV=production
PORT=3000
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=safeops_user
DB_PASSWORD=replace-with-a-unique-database-password
DB_DATABASE=safeops_db
DB_SYNCHRONIZE=false
DB_LOGGING=false
JWT_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-characters
JWT_ISSUER=safeops
JWT_AUDIENCE=safeops-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=true
FRONTEND_URL=https://safeops.example.com
TRUST_PROXY_HOPS=1
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_MAX_FILES=10
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_FROM=no-reply@example.com
MAIL_USER=
MAIL_PASSWORD=
NEXT_PUBLIC_API_URL=https://safeops.example.com/api
NEXT_PUBLIC_WS_URL=https://safeops.example.com
SWAGGER_ENABLED=false
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=SafeOps Administrator
ADMIN_PASSWORD=
SITE_ADDRESS=safeops.example.com
ACME_EMAIL=ops@example.com
