{
  "info": {
    "name": "SafeOps integrated API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Import collection, set email/password, login to save accessToken. The cookie jar stores refresh cookie. baseUrl has no /api suffix. GET roles and incident-types populate actual numeric IDs. Use different accounts for Reporter, Admin/Operator, and Security workflow steps."
  },
